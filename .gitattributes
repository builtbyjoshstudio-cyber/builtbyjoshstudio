# Binary file types — never apply text/EOL normalization.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.mp4 binary
*.mov binary
*.webm binary

# Text files served by the site: always LF, on every OS and autocrlf setting.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.txt text eol=lf
